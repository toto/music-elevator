{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Project: Check",
      "dependsOn": ["Arduino: Build", "Server: Test"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Arduino: Build",
      "type": "process",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn",
        "esp32:esp32:esp32",
        "--build-property",
        "runtime.tools.ctags.path=${workspaceFolder}/tools/arduino-ctags",
        "${workspaceFolder}/firmware/elevator_controller"
      ],
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Arduino: Upload",
      "type": "process",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--upload",
        "--port",
        "/dev/cu.usbserial-23110",
        "--fqbn",
        "esp32:esp32:esp32",
        "--board-options",
        "UploadSpeed=115200",
        "--build-property",
        "runtime.tools.ctags.path=${workspaceFolder}/tools/arduino-ctags",
        "${workspaceFolder}/firmware/elevator_controller"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Arduino: Monitor",
      "type": "process",
      "command": "arduino-cli",
      "args": [
        "monitor",
        "--port",
        "/dev/cu.usbserial-23110",
        "--config",
        "baudrate=115200,dtr=off,rts=off"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Server: Start",
      "type": "process",
      "command": "npm",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Server: Test",
      "type": "process",
      "command": "npm",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
